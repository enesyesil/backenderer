# Local-only convenience values for running repo scripts and emulating workflow inputs.
# Do not commit real values. GitHub Actions secrets are still configured separately in the repo.
# AWS_ROLE_ARN_DEV and AWS_ROLE_ARN_PROD are intentionally omitted here by default because they
# normally live in GitHub secrets. Uncomment locally only if you need to emulate workflow dispatches.
#
# AWS_ROLE_ARN_DEV=arn:aws:iam::123456789012:role/backenderer-dev-github-actions-role
# AWS_ROLE_ARN_PROD=arn:aws:iam::123456789012:role/backenderer-prod-github-actions-role

TFSTATE_BUCKET=backenderer-tf-state
TFSTATE_REGION=ca-central-1
GITHUB_OIDC_PROVIDER_ARN=arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com

AWS_REGION_DEV=ca-central-1
AWS_REGION_PROD=ca-central-1

DEV_AMI_ID=ami-xxxxxxxx
DEV_INSTANCE_TYPE=t3.micro
DEV_NAME_PREFIX=backenderer
DEV_TLS_MODE=none
DEV_ROUTE53_ZONE_ID=
DEV_INSTANCE_PROFILE=

PROD_AMI_ID=ami-yyyyyyyy
PROD_INSTANCE_TYPE=t3.small
PROD_NAME_PREFIX=backenderer
PROD_TLS_MODE=alb_acm
PROD_ROUTE53_ZONE_ID=
PROD_INSTANCE_PROFILE=
