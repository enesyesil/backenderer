github_repo       = "your-org-or-user/your-repo-name"
oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
state_bucket_name = "your-tfstate-bucket"
env               = "prod"
region            = "ca-central-1"
ami_id            = "ami-yyyyyyyyyyyyyyyyy"
health_path       = "/"
instance_type     = "t3.small"
name_prefix       = "backenderer"
tls_mode          = "alb_acm"
route53_zone_id   = "Zxxxxxxxxxxxxxxx"
server_name       = "app.example.com"
