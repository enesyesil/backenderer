{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Backenderer v2 Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["deploy"],
  "properties": {
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "app_name", "container_port", "server_name"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["source", "image"]
        },
        "app_name": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "container_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "health_path": {
          "type": "string",
          "default": "/",
          "pattern": "^/"
        },
        "server_name": {
          "type": "string",
          "minLength": 1
        },
        "image_uri": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": { "const": "image" }
            }
          },
          "then": {
            "required": ["image_uri"]
          }
        }
      ]
    }
  }
}
